Group #content {
  Anchor: (Width: 68, Height: 72);
  Group #icons {
    Anchor: (Width: 64, Height: 64);

    Group #color {
      Anchor: (Width: 58, Height: 58);
      Background: #222121(0.08);
    }

    Group #selector {
      Anchor: (Width: 64, Height: 64);
      Background: PatchStyle(TexturePath: "Textures/frame-base.png");
    }

    Group #icon {
      Anchor: (Width: 48, Height: 48);
      Background: PatchStyle(TexturePath: "Textures/icons/Circle.png");
    }
  }
}